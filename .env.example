# Vorlage für lokale Zugangsdaten.
# Kopieren als ".env" und ausfüllen. Die Datei .env gehört NICHT ins Repository.

# Telegram-Bot (Token von @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail-Versand (16-stelliges App-Passwort, nicht das Kontopasswort)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REMINDER_EMAIL_TO=

# Sprache der Oberfläche: de oder uk
PLANNER_LANGUAGE=de
