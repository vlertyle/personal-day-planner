# Vorlage für lokale Zugangsdaten.
# Kopieren als ".env" und ausfüllen, ODER die Werte direkt in der Registerkarte
# "Erinnerungen" der Anwendung eintragen und auf "Einstellungen speichern"
# klicken - das schreibt automatisch in diese Datei.
# Die Datei .env gehört NICHT ins Repository (siehe .gitignore).

# Telegram-Bot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail-Versand (16-stelliges App-Passwort, nicht das Kontopasswort)
EMAIL_ENABLED=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REMINDER_EMAIL_TO=

# Sprache der Oberfläche: de oder uk
PLANNER_LANGUAGE=de
